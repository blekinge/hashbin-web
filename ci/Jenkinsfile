// Self-contained Jenkins pipeline for the hashbin-web static frontend: build the container
// image and push it to the org Harbor. It replaces the former GitHub Actions workflow —
// this project does not use GitHub Actions.
//
// Mirrors hashbin-quarkus's ci/Jenkinsfile (same Harbor naming + `jenkins-harbor` credential),
// minus the JDK/test stage: a static site needs only an image build, and the image is produced
// from source by Dockerfile.ci (a Node stage compiles the TypeScript; nginx serves dist/), so CI
// never depends on the committed dist/ being fresh.
//
// Why `ci/Jenkinsfile` (not the repository root): the org runs two Jenkins controllers that find
// pipelines by *path* — the legacy one reads `Jenkinsfile` in the root, the current one
// `ci/Jenkinsfile`. Same rationale as hashbin-quarkus, so both services are built by one
// controller and a PR is gated by exactly one real build.

// Shell prelude for steps that drive the docker CLI inside the dind container.
// docker:dind-rootless runs dockerd as a non-root user, whose socket is at $XDG_RUNTIME_DIR/docker.sock
// (i.e. /run/user/<uid>), and the image does NOT export DOCKER_HOST. Do NOT hardcode the uid — derive
// it from the live `id -u` so it is correct whatever user the build agent runs as. Also waits for the
// daemon to answer before returning. (tcp://localhost:2376 is the alternative, but it is TLS-only and
// needs client certs; the derived unix socket is simpler and uid-agnostic.)
String dockerClientEnv() {
    return '''
        set -eu
        RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
        [ -S "$RUNTIME/docker.sock" ] || RUNTIME="/run/user/$(id -u)"
        export XDG_RUNTIME_DIR="$RUNTIME"
        export DOCKER_HOST="unix://$RUNTIME/docker.sock"
        export DOCKER_BUILDKIT=1
        for i in $(seq 1 60); do docker info >/dev/null 2>&1 && break; sleep 1; done
        docker info >/dev/null   # fail fast, clearly, if the daemon never comes up
    '''
}

pipeline {
    agent {
        kubernetes {
            yaml """
                apiVersion: v1
                kind: Pod
                spec:
                  containers:
                  # docker: both the CLI and the daemon that build+push the image. Rootless
                  # dind is unprivileged-capable, but privileged keeps BuildKit happy across
                  # kernel/apparmor variants — same setup hashbin-quarkus uses for its image build.
                  - name: docker
                    image: docker:dind-rootless
                    tty: true
                    securityContext:
                      privileged: true
                    resources:
                      requests: { memory: "1Gi" }
                      limits:   { memory: "2Gi" }
                    volumeMounts:
                    - name: docker-certs
                      mountPath: /docker-certs
                  volumes:
                  - name: docker-certs
                    emptyDir: {}
                """
            retries 2
        }
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')       // cold pull of the node + nginx base images
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    stages {
        stage('Build and push image') {
            steps {
                container('docker') {
                    script {
                        // Harbor image path: harbor.tools.nyx.kb.dk/blekinge/<repo>.
                        // The library segment is the org account 'blekinge' (the Bitbucket-for-
                        // Jenkins env vars are null on this GitHub job, so don't depend on them).
                        def harborName = 'harbor.tools.nyx.kb.dk'
                        def harborLibrary = 'blekinge'
                        // Repo name: Bitbucket var, else GitHub's REPO, else this repo's literal.
                        def projectName = env.BITBUCKET_REPOSITORY ?: env.REPO ?: 'hashbin-web'

                        def validBranchTag = (env.BRANCH_NAME ?: 'dev')
                            .replace('/', '-').replace('+', '-').replace('_', '-')
                            .toLowerCase().take(30).replaceAll(/-+$/, '')

                        // Read the version out of package.json without needing Node (the dind image
                        // has only busybox coreutils): the "version": "x.y.z" line.
                        def version = sh(returnStdout: true, script: '''
                            sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\\([^"]*\\)".*/\\1/p' package.json | head -1
                        ''').trim()

                        def imageVersion = "${version}-${validBranchTag}-sha.${env.GIT_COMMIT}-build.${env.BUILD_NUMBER}"
                        env.IMAGE_TAG = "${harborName}/${harborLibrary}/${projectName}:${imageVersion}"
                        echo "Building and pushing ${env.IMAGE_TAG}"
                    }

                    // Build from source. DOCKER_BUILDKIT=1 honours `# syntax=docker/dockerfile:1`
                    // and enables the modern builder; --target final stops after the nginx stage.
                    sh dockerClientEnv() + '''
                        docker build \
                          --target final \
                          --tag "$IMAGE_TAG" \
                          --file Dockerfile.ci \
                          .
                    '''

                    withCredentials([usernamePassword(credentialsId: 'jenkins-harbor',
                                                      usernameVariable: 'USERNAME',
                                                      passwordVariable: 'PASSWORD')]) {
                        sh dockerClientEnv() + '''
                            printf '%s' "$PASSWORD" | docker login harbor.tools.nyx.kb.dk \
                              --username "$USERNAME" --password-stdin
                            docker push "$IMAGE_TAG"
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Published ${env.IMAGE_TAG}"
        }
    }
}
